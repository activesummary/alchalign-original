<script>\
(function()\{\
  const ENTITLEMENTS_URL = "https://redacted-pipedream-endpoint.invalid";\
  const AUTH_URL         = "https://redacted-pipedream-endpoint.invalid?action=redeem";\
\
  const TOOLS = ["fathom","sliproot","aligndaily","alignmentscan"];\
  const ROUTE = \{ fathom:"/fathom-portal", sliproot:"/sliproot-portal", aligndaily:"/aligndaily-portal", alignmentscan:"/alignment-portal" \};\
  const BUY   = \{ fathom:"/fathom", sliproot:"/sliproot", aligndaily:"/aligndaily", alignmentscan:"/alignmentscan" \};\
  const ICON  = \{ fathom:"\uc0\u55358 \u56800 ", sliproot:"\u55356 \u57151 ", aligndaily:"\u55357 \u56517 ", alignmentscan:"\u55358 \u56813 " \};\
  const NAME  = \{ fathom:"Fathom", sliproot:"Sliproot", aligndaily:"AlignDaily", alignmentscan:"AlignmentScan" \};\
\
  function canonKey(s)\{\
    const k = String(s||"").toLowerCase().trim().replace(/[\\s_-]+/g,"");\
    if (["alignmentscan","alignscan","align-scan","alignment scan"].includes(k)) return "alignmentscan";\
    if (["aligndaily","daily"].includes(k)) return "aligndaily";\
    if (["sliproot"].includes(k)) return "sliproot";\
    if (["fathom"].includes(k)) return "fathom";\
    return k;\
  \}\
\
  if (typeof window.aaGetToken !== "function") \{\
    window.aaGetToken = function()\{\
      return localStorage.getItem("aa_session") ||\
             (document.cookie.match(/(?:^|;\\s*)aa_session=([^;]+)/)||[])[1] || null;\
    \};\
  \}\
\
  function clearSession()\{\
    try\{\
      localStorage.removeItem("aa_session");\
      sessionStorage.removeItem("aa_session");\
    \}catch(_)\{\}\
    const rootDomain = location.hostname.replace(/^www\\./, "");\
    const past = "Thu, 01 Jan 1970 00:00:00 GMT";\
    // clear cookie for current host\
    document.cookie = "aa_session=; expires="+past+"; path=/;";\
    // clear cookie for root domain (if it was set there)\
    document.cookie = "aa_session=; expires="+past+"; path=/; domain=."+rootDomain+";";\
  \}\
\
  const el = \{\
    loading:  document.getElementById("portalLoading"),\
    signin:   document.getElementById("portalSignin"),\
    sendBtn:  document.getElementById("sendLink"),\
    email:    document.getElementById("portalEmail"),\
    msg:      document.getElementById("signinMsg"),\
    content:  document.getElementById("portalContent"),\
    cards:    document.getElementById("portalCards"),\
    user:     document.getElementById("portalUser"),\
    entStatus:document.getElementById("entStatus"),\
    error:    document.getElementById("portalError"),\
    signOut:  document.getElementById("signOut"),\
  \};\
\
  function isValidEmail(v)\{ return /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(v); \}\
\
  // one (and only) sendLink()\
  async function sendLink()\{\
    const email = (el.email.value||"").trim().toLowerCase();\
    if(!isValidEmail(email))\{\
      el.msg.innerHTML = "<span class='warn'>Enter a valid email.</span>";\
      el.email.focus();\
      return;\
    \}\
    const old = el.sendBtn.textContent;\
    el.sendBtn.disabled = true;\
    el.sendBtn.innerHTML = '<span class="mini-spinner" aria-hidden="true"></span>Sending\'85';\
    el.msg.textContent = "";\
\
    try\{\
      const sid = new URLSearchParams(location.search).get("session_id") || "";\
      const r = await fetch(AUTH_URL, \{\
        method:"POST",\
        headers:\{ "content-type":"application/json" \},\
        body: JSON.stringify(\{ email, session_id: sid \})\
      \});\
      const ct  = r.headers.get("content-type") || "";\
      const raw = await r.text();\
      let data  = null; try \{ data = ct.includes("json") ? JSON.parse(raw) : null; \} catch \{\}\
      if ((r.status === 202 || r.status === 429) && data?.reason === "throttled")\{\
        el.msg.innerHTML = "<span class='ok'>Sent.</span> Click the link in your email to log in.";\
      \} else if (r.ok)\{\
        el.msg.innerHTML = "<span class='ok'>Sent.</span> Check your inbox for a secure link.";\
      \} else \{\
        el.msg.innerHTML = "<span class='warn'>Could not send link.</span>";\
      \}\
    \}catch\{\
      el.msg.innerHTML = "<span class='warn'>Network error. Try again.</span>";\
    \}finally\{\
      setTimeout(()=>\{\
        el.sendBtn.innerHTML = old;\
        el.sendBtn.disabled = !isValidEmail((el.email.value||"").trim());\
      \}, 900);\
    \}\
  \}\
\
  // live-enable button on valid email\
  el.sendBtn.disabled = true;\
  el.email.addEventListener("input", ()=>\{\
    el.sendBtn.disabled = !isValidEmail((el.email.value||"").trim());\
  \});\
  el.sendBtn.onclick = sendLink;\
  el.email.addEventListener("keydown", (e)=>\{ if(e.key==="Enter")\{ e.preventDefault(); sendLink(); \}\});\
\
function show(view)\{\
  // hide everything by default\
  el.loading.style.display = "none";\
  el.signin.style.display  = "none";\
  el.content.style.display = "none";\
  el.error.style.display   = "none";\
\
  if (view === "loading") \{\
    el.loading.style.display = "block";\
  \} else if (view === "signin") \{\
    el.signin.style.display = "block";\
  \} else if (view === "content") \{\
    el.content.style.display = "block";\
  \} else if (view === "error") \{\
    // show BOTH the error notice and the magic-link form\
    el.error.style.display  = "block";\
    el.signin.style.display = "block";\
  \}\
\}\
\
  function normalizeCredits(raw)\{\
    const byCanon = \{\};\
    Object.entries(raw||\{\}).forEach(([k,v])=>\{\
      const key = canonKey(k.replace(/^credits_/, ""));\
      byCanon[key] = (byCanon[key]||0) + (parseInt(v,10)||0);\
    \});\
    return byCanon;\
  \}\
\
  function toolCard(key, credits)\{\
    const name = NAME[key] || key, icon = ICON[key] || "\uc0\u55358 \u56809 ";\
    const href = ROUTE[key] || "/tools", buy = BUY[key] || "/tools";\
    const count = credits[key]||0, has = count>0;\
    const chip = has\
      ? `<span class="chip good">$\{count\} run$\{count>1?"s":""\} left</span>`\
      : `<span class="chip warn">No credits</span>`;\
    const openBtn = `<a class="btn primary" $\{has?`href="$\{href\}"`:`aria-disabled="true"`\}>Open</a>`;\
    const buyBtn  = `<a class="btn" href="$\{buy\}">Buy runs</a>`;\
    return `\
      <div class="card">\
        <div class="row"><div class="label"><span class="icon">$\{icon\}</span>$\{name\}</div>$\{chip\}</div>\
        <div class="muted">Access to $\{name\}</div>\
        <div class="row-actions">$\{openBtn\}$\{buyBtn\}</div>\
      </div>`;\
  \}\
\
async function loadEntitlements()\{\
  show("loading");\
  document.title = "Loading your tools\'85";\
  const tok = aaGetToken();\
  if (!tok)\{\
    show("signin");\
    document.title = "Sign in \'95 Your tools";\
    setTimeout(()=> el.email?.focus(), 50);\
    return;\
  \}\
  try\{\
    const r = await fetch(ENTITLEMENTS_URL, \{\
      headers:\{ Authorization: "Bearer " + tok \}\
    \});\
\
    // \uc0\u55357 \u56594  If token is invalid/expired, treat as signed-out\
    if (r.status === 401 || r.status === 403) \{\
      console.warn("[portal] token unauthorized, clearing session");\
      clearSession();\
      el.msg.innerHTML =\
        "<span class='warn'>Your session has expired. Request a new magic link to sign in again.</span>";\
      show("signin");\
      document.title = "Sign in \'95 Your tools";\
      setTimeout(()=> el.email?.focus(), 50);\
      return;\
    \}\
\
    if (!r.ok) \{\
      throw new Error("entitlements_failed (" + r.status + ")");\
    \}\
\
    const e = await r.json();\
    el.user.textContent = e.email || "";\
    const credits = normalizeCredits(e.credits || \{\});\
    el.cards.innerHTML = TOOLS.map(k => toolCard(k, credits)).join("");\
    show("content");\
    document.title = "Your tools";\
    el.cards.querySelector('.btn.primary[href]')?.focus();\
  \}catch(err)\{\
    console.error("[portal] entitlements error:", err);\
    show("error");                     // now shows error + signin form\
    document.title = "Error \'95 Your tools";\
  \}\
\}\
\
  // Robust sign out\
  el.signOut.onclick = (e)=>\{\
    e.preventDefault();\
    clearSession();\
    // hard reload with cache-buster to prevent any stale state\
    location.replace("/portal?signedout=1&t="+Date.now());\
  \};\
\
  loadEntitlements();\
\})();\
</script>\
}